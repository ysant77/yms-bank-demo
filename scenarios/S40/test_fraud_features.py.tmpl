"""Acceptance tests for {KEY}: the fraud score uses past data only."""

import numpy as np

from fraud.features import HISTORY, NO_SOURCE


def test_{TOKEN}_features_use_past_only(fraud_run):
    # Checks the source time of every value actually built, after the chargeback join.
    for matrix in (fraud_run.train, fraud_run.test):
        for j, (name, kind) in enumerate(zip(matrix.names, matrix.kinds, strict=True)):
            source = matrix.source_ts[:, j]
            used = source != NO_SOURCE
            if kind == HISTORY:
                late = used & (source >= matrix.ts)
            else:
                late = used & (source > matrix.ts)
            assert not late.any(), f"{name}: {int(late.sum())} rows use data from ts or later"


def test_{TOKEN}_holdout_auc(fraud_run, record_metric):
    holdout_days = fraud_run.test_rows["day"]
    assert holdout_days.min() == 61 and holdout_days.max() == 90
    assert np.all(fraud_run.train_rows["day"] <= 60)
    record_metric("auc", fraud_run.metrics["auc"])
